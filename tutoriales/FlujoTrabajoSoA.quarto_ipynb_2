        "\n",
        "ax.set_yticks(range(len(familias_orden)))\n",
        "ax.set_yticklabels(familias_orden)\n",
        "ax.set_xlabel(\"Año\")\n",
        "ax.set_title(\"Diagrama de cosecha: dirección visual de la evidencia\")\n",
