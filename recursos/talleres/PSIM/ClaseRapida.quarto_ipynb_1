        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from skimage import io, color, exposure, filters, morphology, measure\n",
        "\n",
        "# 1. Cargar imagen\n",
        "image_path = \"imagen_medica.png\"\n",
        "image = io.imread(image_path)\n",
        "\n",
        "# 2. Escala de grises\n",
        "if image.ndim == 3:\n",
        "    image_gray = color.rgb2gray(image)\n",
        "else:\n",
        "    image_gray = image.astype(float)\n",
        "\n",
        "# 3. Normalización\n",
        "image_norm = (image_gray - image_gray.min()) / (image_gray.max() - image_gray.min())\n",
        "\n",
        "# 4. Mejora de contraste\n",
        "image_clahe = exposure.equalize_adapthist(image_norm, clip_limit=0.03)\n",
        "\n",
        "# 5. Filtrado\n",
        "image_smooth = filters.gaussian(image_clahe, sigma=1.2)\n",
        "\n",
        "# 6. Segmentación\n",
        "threshold = filters.threshold_otsu(image_smooth)\n",
        "mask = image_smooth > threshold\n",
        "\n",
        "# 7. Limpieza morfológica\n",
        "mask_clean = morphology.remove_small_objects(mask, min_size=500)\n",
        "mask_clean = morphology.remove_small_holes(mask_clean, area_threshold=500)\n",
        "mask_clean = morphology.closing(mask_clean, morphology.disk(3))\n",
        "\n",
        "# 8. Etiquetado y métricas\n",
        "labels = measure.label(mask_clean)\n",
        "regions = measure.regionprops(labels, intensity_image=image_norm)\n",
        "\n",
        "print(f\"Número de regiones detectadas: {len(regions)}\")\n",
        "\n",
        "if len(regions) > 0:\n",
        "    largest_region = max(regions, key=lambda r: r.area)\n",
        "\n",
        "    print(\"Región principal\")\n",
        "    print(f\"Área: {largest_region.area}\")\n",
        "    print(f\"Perímetro: {largest_region.perimeter:.2f}\")\n",
        "    print(f\"Intensidad media: {largest_region.mean_intensity:.3f}\")\n",
        "\n",
        "# 9. Contornos\n",
        "contours = measure.find_contours(mask_clean, level=0.5)\n",
        "\n",
        "# 10. Visualización final\n",
        "plt.figure(figsize=(7, 7))\n",
        "plt.imshow(image_norm, cmap=\"gray\")\n",
        "\n",
        "for contour in contours:\n",
        "    plt.plot(contour[:, 1], contour[:, 0], linewidth=1.5)\n",
        "\n",
        "plt.title(\"Segmentación sobre imagen original\")\n",
        "plt.axis(\"off\")\n",
        "plt.show()"
      ],
