      "source": [
        "#| label: denoising-wavelet\n",
        "#| include: false\n",
        "\n",
        "def crop_like(image, reference):\n",
        "    \"\"\"\n",
        "    Recorta la imagen reconstruida para igualar el tamaño de la imagen de referencia.\n",
        "    \"\"\"\n",
        "    return image[:reference.shape[0], :reference.shape[1]]\n",
        "\n",
        "\n",
        "def bayes_shrink_threshold(band, sigma_noise):\n",
        "    \"\"\"\n",
        "    Umbral BayesShrink robusto para una subbanda wavelet.\n",
        "\n",
        "    En el ejemplo sintético se usa sigma_noise conocido porque el ruido fue\n",
        "    generado explícitamente. En una imagen médica real, este valor debe estimarse\n",
        "    desde una región de fondo, una región homogénea o un modelo de ruido adecuado\n",
        "    para la modalidad.\n",
        "    \"\"\"\n",
        "    band = np.nan_to_num(band, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "\n",
        "    observed_variance = np.var(band)\n",
        "\n",
        "    if not np.isfinite(observed_variance) or observed_variance <= 0:\n",
        "        return 0.0\n",
        "\n",
        "    signal_variance = observed_variance - sigma_noise**2\n",
        "\n",
        "    if not np.isfinite(signal_variance) or signal_variance <= 0:\n",
        "        return np.max(np.abs(band))\n",
        "\n",
        "    sigma_signal = np.sqrt(signal_variance)\n",
        "\n",
        "    threshold = sigma_noise**2 / sigma_signal\n",
        "\n",
        "    if not np.isfinite(threshold) or threshold < 0:\n",
        "        threshold = np.max(np.abs(band))\n",
        "\n",
        "    return threshold\n",
        "\n",
        "\n",
        "# En este ejemplo sintético sí conocemos la desviación estándar del ruido agregado.\n",
        "# Esta corrección evita que la mediana de una subbanda dominada por fondo negro\n",
        "# produzca un sigma estimado artificialmente cercano a cero.\n",
        "sigma_estimated = noise_sigma\n",
        "\n",
        "coeffs_denoised = [np.nan_to_num(coeffs[0], nan=0.0, posinf=0.0, neginf=0.0)]\n",
        "\n",
        "threshold_rows = []\n",
        "\n",
        "for decomposition_index, detail_tuple in enumerate(coeffs[1:], start=1):\n",
        "\n",
        "    # La lista coeffs[1:] viene desde el nivel más grueso hasta el más fino.\n",
        "    # Esta conversión permite reportar niveles como 3, 2, 1.\n",
        "    level = decomposition_level - decomposition_index + 1\n",
        "\n",
        "    denoised_detail = []\n",
        "\n",
        "    for orientation, band in zip(\n",
        "        [\"horizontal\", \"vertical\", \"diagonal\"],\n",
        "        detail_tuple\n",
        "    ):\n",
        "        band = np.nan_to_num(band, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "\n",
        "        threshold = bayes_shrink_threshold(\n",
        "            band=band,\n",
        "            sigma_noise=sigma_estimated\n",
        "        )\n",
        "\n",
        "        denoised_band = pywt.threshold(\n",
        "            band,\n",
        "            value=threshold,\n",
        "            mode=\"soft\"\n",
        "        )\n",
        "\n",
        "        denoised_band = np.nan_to_num(\n",
        "            denoised_band,\n",
        "            nan=0.0,\n",
        "            posinf=0.0,\n",
        "            neginf=0.0\n",
        "        )\n",
        "\n",
        "        threshold_rows.append(\n",
        "            {\n",
        "                \"nivel\": level,\n",
        "                \"orientacion\": orientation,\n",
        "                \"umbral\": threshold,\n",
        "                \"energia_antes\": np.sum(np.abs(band) ** 2),\n",
        "                \"energia_despues\": np.sum(np.abs(denoised_band) ** 2)\n",
        "            }\n",
        "        )\n",
        "\n",
        "        denoised_detail.append(denoised_band)\n",
        "\n",
        "    coeffs_denoised.append(tuple(denoised_detail))\n",
        "\n",
        "\n",
        "image_denoised = pywt.waverec2(\n",
