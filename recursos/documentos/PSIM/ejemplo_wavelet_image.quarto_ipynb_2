        "#| label: metricas-denoising\n",
        "#| include: false\n",
        "\n",
        "def root_mean_squared_error(reference, test):\n",
        "    reference = np.nan_to_num(reference, nan=0.0, posinf=1.0, neginf=0.0)\n",
        "    test = np.nan_to_num(test, nan=0.0, posinf=1.0, neginf=0.0)\n",
        "\n",
        "    mse = np.mean((reference - test) ** 2)\n",
        "\n",
        "    if not np.isfinite(mse):\n",
        "        return np.nan\n",
        "\n",
        "    return np.sqrt(mse)\n",
        "\n",
        "\n",
        "def peak_signal_to_noise_ratio(reference, test, data_range=1.0):\n",
        "    reference = np.nan_to_num(reference, nan=0.0, posinf=1.0, neginf=0.0)\n",
        "    test = np.nan_to_num(test, nan=0.0, posinf=1.0, neginf=0.0)\n",
        "\n",
        "    mse = np.mean((reference - test) ** 2)\n",
        "\n",
        "    if not np.isfinite(mse):\n",
        "        return np.nan\n",
        "\n",
        "    if mse == 0:\n",
        "        return np.inf\n",
        "\n",
        "    return 10 * np.log10((data_range ** 2) / mse)\n",
        "\n",
        "\n",
        "rmse_noisy = root_mean_squared_error(image_clean, image_noisy)\n",
        "rmse_denoised = root_mean_squared_error(image_clean, image_denoised)\n",
        "\n",
        "psnr_noisy = peak_signal_to_noise_ratio(image_clean, image_noisy)\n",
        "psnr_denoised = peak_signal_to_noise_ratio(image_clean, image_denoised)\n",
        "\n",
        "mean_absolute_change = np.mean(np.abs(image_denoised - image_noisy))\n",
        "max_absolute_change = np.max(np.abs(image_denoised - image_noisy))\n",
        "\n",
        "metrics_table = pd.DataFrame(\n",
        "    {\n",
        "        \"imagen\": [\"Con ruido\", \"Filtrada por wavelet\"],\n",
        "        \"raiz_error_cuadratico_medio\": [rmse_noisy, rmse_denoised],\n",
        "        \"relacion_senal_ruido_pico_db\": [psnr_noisy, psnr_denoised]\n",
        "    }\n",
        ")\n",
        "\n",
