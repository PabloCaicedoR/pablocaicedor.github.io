        "#| label: setup-ejemplo-wavelet\n",
        "#| include: false\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import pywt\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "def add_ellipse(image, cy, cx, ry, rx, angle_deg, intensity):\n",
        "    \"\"\"\n",
        "    Agrega una elipse a una imagen sintética.\n",
        "    cy, cx: centro de la elipse.\n",
        "    ry, rx: radios vertical y horizontal.\n",
        "    angle_deg: rotación en grados.\n",
        "    intensity: intensidad agregada.\n",
        "    \"\"\"\n",
        "    y, x = np.indices(image.shape)\n",
        "    angle = np.deg2rad(angle_deg)\n",
        "\n",
        "    x0 = x - cx\n",
        "    y0 = y - cy\n",
        "\n",
        "    xr = x0 * np.cos(angle) + y0 * np.sin(angle)\n",
        "    yr = -x0 * np.sin(angle) + y0 * np.cos(angle)\n",
        "\n",
        "    mask = (xr / rx) ** 2 + (yr / ry) ** 2 <= 1\n",
        "    image[mask] += intensity\n",
        "\n",
        "    return mask\n",
        "\n",
        "\n",
        "def normalize01(image):\n",
        "    image = image.astype(float)\n",
        "    min_val = np.min(image)\n",
        "    max_val = np.max(image)\n",
        "    return (image - min_val) / (max_val - min_val + 1e-12)\n",
        "\n",
        "\n",
        "def robust_display(image):\n",
        "    \"\"\"\n",
        "    Normalización robusta para visualización.\n",
        "    Evita que valores extremos dominen el contraste.\n",
        "    \"\"\"\n",
        "    p1, p99 = np.percentile(image, [1, 99])\n",
        "    return np.clip((image - p1) / (p99 - p1 + 1e-12), 0, 1)\n",
        "\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# Creación de un fantoma médico sintético\n",
        "# -------------------------------------------------------------------------\n",
        "\n",
        "N = 256\n",
        "image_clean = np.zeros((N, N), dtype=float)\n",
        "\n",
        "# Región anatómica principal\n",
        "brain_mask = add_ellipse(\n",
        "    image_clean,\n",
        "    cy=128,\n",
        "    cx=128,\n",
        "    ry=92,\n",
        "    rx=72,\n",
        "    angle_deg=0,\n",
        "    intensity=0.45\n",
        ")\n",
        "\n",
        "# Regiones internas con contraste suave\n",
        "add_ellipse(image_clean, 122, 103, 48, 22, -18, 0.12)\n",
        "add_ellipse(image_clean, 125, 153, 50, 23, 18, 0.10)\n",
        "\n",
        "# Cavidades o regiones hipointensas\n",
        "add_ellipse(image_clean, 120, 126, 20, 8, -10, -0.18)\n",
        "add_ellipse(image_clean, 122, 140, 20, 8, 10, -0.18)\n",
        "\n",
        "# Lesión sintética hiperintensa\n",
        "lesion_mask = add_ellipse(\n",
        "    image_clean,\n",
        "    cy=92,\n",
        "    cx=158,\n",
        "    ry=13,\n",
        "    rx=18,\n",
        "    angle_deg=25,\n",
        "    intensity=0.38\n",
        ")\n",
        "\n",
        "# Región periférica de menor intensidad alrededor de la lesión\n",
        "add_ellipse(image_clean, 94, 158, 22, 29, 25, 0.08)\n",
        "\n",
        "# Campo de intensidad no uniforme, semejante a una inhomogeneidad suave\n",
        "yy, xx = np.indices((N, N))\n",
        "bias_field = 0.90 + 0.18 * (xx / N) + 0.08 * (yy / N)\n",
        "image_clean = image_clean * bias_field\n",
        "\n",
        "# Se restringe la imagen al dominio anatómico principal\n",
        "image_clean = image_clean * brain_mask\n",
        "image_clean = normalize01(image_clean)\n",
        "\n",
        "# Ruido aditivo para simular degradación de adquisición\n",
        "noise_sigma = 0.065\n",
        "noise = np.random.normal(0, noise_sigma, size=image_clean.shape)\n",
        "image_noisy = np.clip(image_clean + noise * brain_mask, 0, 1)\n",
        "\n",
        "# Parámetros wavelet\n",
        "wavelet_name = \"sym4\"\n",
        "decomposition_level = 3\n",
        "extension_mode = \"symmetric\"\n",
        "\n",
        "coeffs = pywt.wavedec2(\n",
        "    image_noisy,\n",
        "    wavelet=wavelet_name,\n",
        "    level=decomposition_level,\n",
        "    mode=extension_mode\n",
        ")"
