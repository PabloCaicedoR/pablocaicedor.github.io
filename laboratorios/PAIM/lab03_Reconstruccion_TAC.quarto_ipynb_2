        "---\n",
        "title: \"Tutorial: Reconstrucción en tomografía axial computarizada, desde la adquisición hasta un volumen tridimensional\"\n",
        "subtitle: \"Fuente → Objeto → Detector → (normalización + log) → Radiografía lista para ver\"\n",
        "lang: es\n",
        "author: \"Ph.D. Pablo Eduardo Caicedo Rodríguez\"\n",
        "date: last-modified\n",
        "format:\n",
        "  html:\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    code-fold: true\n",
